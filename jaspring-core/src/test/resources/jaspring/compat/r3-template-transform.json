[
 {
  "name": "should parse incomplete tags terminated by EOF",
  "html": "<a",
  "ignoreError": true,
  "expected": [
   [
    "Element",
    "a"
   ]
  ]
 },
 {
  "name": "should parse incomplete tags terminated by another tag",
  "html": "<a <span></span>",
  "ignoreError": true,
  "expected": [
   [
    "Element",
    "a"
   ],
   [
    "Element",
    "span"
   ]
  ]
 },
 {
  "name": "should parse text nodes",
  "html": "a",
  "ignoreError": false,
  "expected": [
   [
    "Text",
    "a"
   ]
  ]
 },
 {
  "name": "should parse elements with attributes",
  "html": "<div a=b></div>",
  "ignoreError": false,
  "expected": [
   [
    "Element",
    "div"
   ],
   [
    "TextAttribute",
    "a",
    "b"
   ]
  ]
 },
 {
  "name": "should parse ngContent when it contains WS only",
  "html": "<ng-content select=\"a\">    \n   </ng-content>",
  "ignoreError": false,
  "expected": [
   [
    "Content",
    "a"
   ],
   [
    "TextAttribute",
    "select",
    "a"
   ]
  ]
 },
 {
  "name": "should parse ngContent regardless the namespace",
  "html": "<svg><ng-content select=\"a\"></ng-content></svg>",
  "ignoreError": false,
  "expected": [
   [
    "Element",
    ":svg:svg"
   ],
   [
    "Content",
    "a"
   ],
   [
    "TextAttribute",
    "select",
    "a"
   ]
  ]
 },
 {
  "name": "should parse bound text nodes",
  "html": "{{a}}",
  "ignoreError": false,
  "expected": [
   [
    "BoundText",
    "{{ a }}"
   ]
  ]
 },
 {
  "name": "should parse mixed case bound properties",
