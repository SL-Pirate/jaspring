 },
 {
  "name": "should parse a let declaration",
  "html": "@let foo = 123 + 456;",
  "ignoreError": false,
  "expected": [
   [
    "LetDeclaration",
    "foo",
    "123 + 456"
   ]
  ]
 },
 {
  "name": "should produce a text node when @let is used inside ngNonBindable",
  "html": "<div ngNonBindable>@let foo = 123;</div>",
  "ignoreError": false,
  "expected": [
   [
    "Element",
    "div"
   ],
   [
    "TextAttribute",
    "ngNonBindable",
    ""
   ],
   [
    "Text",
    "@let foo = 123;"
   ]
  ]
 }
]