 {
  "name": "should parse an if block",
  "html": "\n        @if (cond.expr; as foo) {\n          Main case was true!\n        } @else if (other.expr) {\n          Extra case was true!\n        } @else {\n          False case!\n        }\n        ",
  "ignoreError": false,
  "expected": [
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "cond.expr"
   ],
   [
    "Variable",
    "foo",
    "foo"
   ],
   [
    "Text",
    " Main case was true! "
   ],
   [
    "IfBlockBranch",
    "other.expr"
   ],
   [
    "Text",
    " Extra case was true! "
   ],
   [
    "IfBlockBranch",
    null
   ],
   [
    "Text",
    " False case! "
   ]
  ]
 },
 {
  "name": "should parse an if block with optional parentheses",
  "html": "\n        @if ((cond.expr)) {\n          Main case was true!\n        } @else if ((other.expr)) {\n          Extra case was true!\n        } @else {\n          False case!\n        }\n        ",
  "ignoreError": false,
  "expected": [
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "(cond.expr)"
   ],
   [
    "Text",
    " Main case was true! "
   ],
   [
    "IfBlockBranch",
    "(other.expr)"
   ],
   [
    "Text",
    " Extra case was true! "
   ],
   [
    "IfBlockBranch",
    null
   ],
   [
    "Text",
    " False case! "
   ]
  ]
 },
 {
  "name": "should parse nested if blocks",
  "html": "\n        @if (a) {\n          @if (a1) {\n            a1\n          } @else {\n            b1\n          }\n        }\n        @else if (b) {\n          b\n        } @else {\n          @if (c1) {\n            c1\n          } @else if (c2) {\n            c2\n          } @else {\n            c3\n          }\n        }\n        ",
  "ignoreError": false,
  "expected": [
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "a"
   ],
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "a1"
   ],
   [
    "Text",
    " a1 "
   ],
   [
    "IfBlockBranch",
    null
   ],
   [
    "Text",
    " b1 "
   ],
   [
    "IfBlockBranch",
    "b"
   ],
   [
    "Text",
    " b "
   ],
   [
    "IfBlockBranch",
    null
   ],
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "c1"
   ],
   [
    "Text",
    " c1 "
   ],
   [
    "IfBlockBranch",
    "c2"
   ],
   [
    "Text",
    " c2 "
   ],
   [
    "IfBlockBranch",
    null
   ],
   [
    "Text",
    " c3 "
   ]
  ]
 },
 {
  "name": "should parse an else if block with multiple spaces",
  "html": "\n        @if (cond.expr; as foo) {\n          Main case was true!\n        } @else        if (other.expr) {\n          Other case was true!\n        }\n        ",
  "ignoreError": false,
  "expected": [
   [
    "IfBlock"
   ],
   [
    "IfBlockBranch",
    "cond.expr"
   ],
   [
    "Variable",
    "foo",
    "foo"
   ],
   [
    "Text",
    " Main case was true! "
   ],
   [
    "IfBlockBranch",
    "other.expr"
   ],
   [
    "Text",
    " Other case was true! "
   ]
  ]
 },
