 {
  "name": "should parse class bindings with various characters",
  "html": "<foo [class.text-primary/80]=\"expr\" [class.data-active:text-green-300/80]=\"expr2\" [class.data-[size='large']:p-8] = \"expr3\" some-attr/>",
  "ignoreError": false,
  "expected": [
   [
    "Element",
    "foo",
    "#selfClosing"
   ],
   [
    "TextAttribute",
    "some-attr",
    ""
   ],
   [
    "BoundAttribute",
    2,
    "text-primary/80",
    "expr"
   ],
   [
    "BoundAttribute",
    2,
    "data-active:text-green-300/80",
    "expr2"
   ],
   [
    "BoundAttribute",
    2,
    "data-[size='large']:p-8",
    "expr3"
   ]
  ]
 },
