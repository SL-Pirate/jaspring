FROM docker.io/library/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git python3 unzip gzip tar && rm -rf /var/lib/apt/lists/*

# GraalVM 25.2.4 (innovation 2), matching gradle/libs.versions.toml and the CI workflows.
ARG GRAALVM_URL=https://gds.oracle.com/download/graal/25i2/archive/graalvm-jdk-25i2-25.0.4_linux-x64_bin.tar.gz
RUN mkdir -p /opt/graalvm && curl --fail --silent --show-error --location --retry 3 "$GRAALVM_URL" -o /tmp/graalvm.tar.gz && tar -xzf /tmp/graalvm.tar.gz --strip-components=1 -C /opt/graalvm && rm /tmp/graalvm.tar.gz

# Binaryen >= 119 assembles the Web Image build; Ubuntu 24.04 packages an older version.
ARG BINARYEN_VERSION=133
COPY binaryen.sha256 /tmp/binaryen.sha256
RUN curl --fail --silent --show-error --location --retry 3 \
      "https://github.com/WebAssembly/binaryen/releases/download/version_${BINARYEN_VERSION}/binaryen-version_${BINARYEN_VERSION}-x86_64-linux.tar.gz" -o /tmp/binaryen.tar.gz \
    && echo "$(cat /tmp/binaryen.sha256)  /tmp/binaryen.tar.gz" | sha256sum --check \
    && mkdir -p /opt/binaryen && tar -xzf /tmp/binaryen.tar.gz --strip-components=1 -C /opt/binaryen && rm /tmp/binaryen.tar.gz /tmp/binaryen.sha256

# Node 24 and pnpm run the client shim's unit tests.
RUN curl --fail --silent --show-error --location https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@10

ENV JAVA_HOME=/opt/graalvm
ENV PATH=/opt/graalvm/bin:/opt/binaryen/bin:$PATH
ENV GRADLE_USER_HOME=/gradle-cache
WORKDIR /workspace
